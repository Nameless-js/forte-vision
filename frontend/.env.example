# Python server. Set environment variables before starting uvicorn.
API_KEY=replace-with-a-random-team-secret
DATABASE_BACKEND=sqlite
# Optional local/self-hosted Supabase; never expose this key to React.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# Local engine profile (auto selects GPU when available)
FORTE_PROFILE=auto
