{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://manor-rice-peripheral-blake.trycloudflare.com/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-api-key"
          },
          "args": "$API_KEY",
          "env": [
            "API_KEY"
          ]
        },
        {
          "type": "response.headers",
          "op": "set",
          "target": {
            "key": "cache-control"
          },
          "args": "no-store"
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
