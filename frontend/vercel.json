{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "dest": "/deployment-health.json",
      "src": "/api/health"
    },
    {
      "dest": "/backend-unavailable.json",
      "src": "/api/.*",
      "status": 503
    },
    {
      "handle": "filesystem"
    },
    {
      "dest": "/index.html",
      "src": "/.*"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
